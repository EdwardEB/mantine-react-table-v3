    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.15",
    "next-plausible": "^3.12.4",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
