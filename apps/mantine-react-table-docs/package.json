{
  "name": "mantine-react-table-docs",
  "private": true,
  "scripts": {
    "build": "pnpm docs:build",
    "clean": "rm -rf node_modules && rm -rf dist && rm -rf .next && rm -rf .turbo && rm -rf .next",
    "dev": "pnpm docs:dev",
    "docs:build": "next build && pnpm docs:sitemap",
    "docs:dev": "next dev --port 3001",
    "docs:sitemap": "next-sitemap --config ./next-sitemap.config.cjs",
    "docs:start": "next start --port 4001",
    "lint": "next lint",
    "start": "pnpm docs:start",
    "sitemap": "pnpm docs:sitemap"
  },
  "dependencies": {
    "@docsearch/js": "3.9.0",
    "@faker-js/faker": "^9.0.3",
    "@fortawesome/fontawesome-svg-core": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@mantine/code-highlight": "9.0.1",
    "@mantine/core": "9.0.1",
    "@mantine/dates": "9.0.1",
    "@mantine/hooks": "9.0.1",
    "@mantine/modals": "9.0.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^15.5.2",
    "@tabler/icons-react": "3.34.1",
    "@tanstack/react-query": "^5.87.1",
    "@types/mdx": "^2.0.13",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.18",
